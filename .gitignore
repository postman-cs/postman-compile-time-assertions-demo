# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Local environment / secrets (never commit credentials)
.env
.env.*
!.env.example

# Postman state generated by repo-sync at run time. The demo is ephemeral:
# onboarding creates these on disk, CI uploads them as artifacts, teardown
# deletes the cloud resources. None of it is committed, so the repo stays
# re-runnable from a clean tree.
.postman/
postman/collections/
postman/environments/

# Local test reports
/reports/
*.junit.xml

# OS noise
.DS_Store
